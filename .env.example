# Kopie als ".env" anlegen und ausfüllen. Die Datei .env niemals veröffentlichen.
PORT=5510
SITE_URL=http://localhost:5510

# Erster Admin-Zugang (wird nur beim allerersten Start angelegt)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-Mail-Versand über Ihr Postfach (Angaben vom E-Mail-Anbieter)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# KI-Assistent im Kundenportal (Baustein H4) – Schluessel aus console.anthropic.com > API Keys.
# Ohne Schluessel laeuft alles wie bisher, nur ohne Assistent. Nach dem Eintragen den Server neu starten.
ANTHROPIC_API_KEY=
